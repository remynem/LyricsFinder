# ─── Auth ──────────────────────────────────────────────────────────────────────
API_KEY=lyricsfinder-dev
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ─── PostgreSQL — Neon ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://neondb_owner:PASSWORD@ep-xxx.neon.tech/neondb?sslmode=require

# ─── Qdrant Cloud ──────────────────────────────────────────────────────────────
VECTOR_DB=qdrant
QDRANT_URL=https://xxx.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ─── Redis — Upstash ───────────────────────────────────────────────────────────
REDIS_URL=rediss://default:PASSWORD@xxx.upstash.io:6379

# ─── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=sentence_transformers
SENTENCE_TRANSFORMERS_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ─── Elasticsearch (optionnel en dev) ─────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://lyricsfinder.vercel.app","http://localhost:3000"]

# ─── Optionnel ─────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# MUSIXMATCH_API_KEY=
# DEEPL_API_KEY=
