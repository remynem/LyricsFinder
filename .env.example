# ─── Required ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-run-openssl-rand-hex-32
API_KEY=dev-key

# Database (Docker Compose sets these automatically)
DATABASE_URL=postgresql+asyncpg://lyricfinder:lyricfinder@db:5432/lyricfinder

# Vector DB
QDRANT_URL=http://qdrant:6333
VECTOR_DB=qdrant

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# Redis
REDIS_URL=redis://redis:6379

# ─── Embeddings (choose one provider) ─────────────────────────────────────────
EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large

SENTENCE_TRANSFORMERS_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384   # 3072 for text-embedding-3-large

# ─── Optional integrations ────────────────────────────────────────────────────
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# MUSIXMATCH_API_KEY=
# LYRICFIND_API_KEY=

# DEEPL_API_KEY=
# GOOGLE_TRANSLATE_KEY=

# SENTRY_DSN=

# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1

# PINECONE_API_KEY=
# PINECONE_INDEX=lyricfinder

# ─── Performance tuning ───────────────────────────────────────────────────────
SEARCH_CANDIDATE_LIMIT=200
INGEST_BATCH_SIZE=64
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_HNSW_EF=128
CACHE_TTL_SECONDS=300
